# ~/np/.env  --  setup.sh copies this file there and sets it to chmod 600.
# NEVER commit the filled-in copy. .gitignore blocks it, but check anyway.

# --- Spotify (developer.spotify.com/dashboard -> your app -> Settings) ------
# The redirect URI must match the one in the dashboard EXACTLY.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8080/callback

# --- Google Drive upload (optional; leave blank to save photos locally only) -
# Google Cloud console -> OAuth client of type "TVs and Limited Input devices",
# Drive API enabled, scope drive.file. Then run: ~/np/bin/python ~/np/gdrive_auth.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Where the display is (clock + weather overlay) ------------------------
# An IANA zone name, e.g. Europe/London, America/New_York. Leave blank to use
# the Pi's system time zone.
NP_TIMEZONE=
# Decimal degrees, 2-3 decimals is plenty. Leave blank to turn weather off.
NP_LAT=
NP_LON=
